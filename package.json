{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ./scripts/inline-css.mjs",
    "build:api": "node ./scripts/build-api.mjs",
    "images": "node ./scripts/prepare-images.mjs",
    "logos": "node ./scripts/prepare-logos.mjs",
    "og": "node ./scripts/build-og.mjs",
    "assets": "node ./scripts/prepare-images.mjs && node ./scripts/prepare-logos.mjs && node ./scripts/build-og.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build:api && sls deploy",
    "admin:create": "./scripts/create-admin.sh",
    "admin:reset-mfa": "./scripts/reset-admin-mfa.sh",
    "publish": "./scripts/publish.sh",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "driver.js": "^1.10.2",
    "next": "15.5.28",
    "next-seo": "^7.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
